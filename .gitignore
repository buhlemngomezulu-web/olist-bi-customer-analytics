# Data: everything here is regenerated by scripts/01-07 in order.
# Raw CSVs (~120MB) and the SQLite DB (~130MB) are too large/regenerable
# to belong in git. Small reference outputs (query_results/, model_metrics.csv,
# statistical_test_results.csv) ARE kept since they're tiny and useful to
# browse without rerunning anything.
data/raw/*.csv
data/processed/olist.db
data/processed/fact_orders.csv
data/processed/customer_rfm.csv
data/processed/*_clean.csv

